{
  "name": "backend",
  "version": "1.0.0",
  "description": "Palisad backend",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon --exec \"node --loader ./alias-loader.mjs\" server.js",
    "start": "node --loader ./alias-loader.mjs server.js",
    "lint": "eslint .",
    "migrate": "knex --knexfile knexfile.cjs migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.cjs migrate:rollback",
    "seed": "knex --knexfile knexfile.cjs seed:run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "_moduleAliases": {
    "@": "./src"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.9",
    "module-alias": "^2.3.4",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "nanoid": "^5.1.7",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^10.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^3.2.6"
  }
}
